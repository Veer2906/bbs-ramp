# Copy to .env.local and fill in. Everything here stays on the server.

# Sail Research API key (https://docs.sailresearch.com). Required: the agent's browser runs in a Sailbox.
SAIL_API_KEY=

# Model provider. Pick it in Settings; set credentials for one or both.
# Anthropic API
ANTHROPIC_API_KEY=

# AWS Bedrock: either a Bedrock API key (bearer token)...
AWS_BEARER_TOKEN_BEDROCK=
# ...or standard AWS credentials (keys or a profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
AWS_REGION=us-east-1

# OpenAI API (GPT models)
OPENAI_API_KEY=

# Optional
# SAIL_APP=ledger-agent        # Sail app that owns the Sailbox
# AGENT_DATA_DIR=./.data       # where documents, runs and settings are stored

# Vault: key that encrypts saved portal passwords. Any long random string.
# If unset, one is generated in .data/vault.key (back it up; losing it means re-entering passwords).
# VAULT_KEY=

# Supabase storage (optional; without it everything stays in .data/)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # server-only key
# SUPABASE_DB_URL=                # optional Postgres connection string; app creates its tables on start
# SUPABASE_BUCKET=documents       # private Storage bucket for original files
